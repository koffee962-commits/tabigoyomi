{
  "name": "tabigoyomi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npx wrangler dev --port 8787",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "db:migrate": "npx wrangler d1 execute tabigoyomi-db --remote --file=./migrations/0001_init.sql",
    "db:migrate:local": "npx wrangler d1 execute tabigoyomi-db --local --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
